{
  "name": "neev",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:web": "expo export --platform web",
    "serve:web": "pnpm dlx serve dist",
    "prebuild:clean": "expo prebuild --clean",
    "compile": "tsc --noEmit -p . --pretty",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts,.tsx --quiet --fix",
    "lint:check": "eslint src test --ext .ts,.tsx --quiet",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "doctor": "node scripts/doctor.js",
    "bump": "node scripts/bump-version.js",
    "release:patch": "node scripts/bump-version.js patch",
    "release:minor": "node scripts/bump-version.js minor",
    "release:major": "node scripts/bump-version.js major",
    "setup:hooks": "bash scripts/setup-git-hooks.sh",
    "prepare": "pnpm run setup:hooks",
    "ci:check": "pnpm run lint:check && pnpm run typecheck && pnpm run test",
    "deps:check": "depcruise src --config .dependency-cruiser.js",
    "deps:graph": "depcruise src --include-only \"^src\" --config .dependency-cruiser.js --output-type dot > app-dependency-graph.dot && dot -T svg app-dependency-graph.dot -o app-dependency-graph.svg && dot -T png app-dependency-graph.dot -o app-dependency-graph.png && rm app-dependency-graph.dot",
    "align-deps": "expo install --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=com.amit.neev .maestro/flows",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "android:release:device": "expo run:android --variant release --device",
    "android:release:logs": "adb logcat -c && adb logcat -v time | tee /tmp/neev-release-logcat.txt | grep --line-buffered -iE 'FATAL EXCEPTION|JavascriptException|Neev|AndroidRuntime|ReactNativeJS'",
    "build:local": "eas build --platform android --profile production-local --local",
    "build:cloud": "eas build --platform android --profile production",
    "build:preview": "eas build --platform android --profile preview --local",
    "build:bundle": "cd android && ./gradlew --no-daemon :app:bundleRelease",
    "build:apk": "cd android && ./gradlew --no-daemon assembleRelease -PreactNativeArchitectures=${BLINKQUEST_APK_ARCHS:-arm64-v8a}",
    "ota:prod": "RUNTIME_VERSION_POLICY=fingerprint eas update --channel production --platform android --environment production",
    "ota:preview": "eas update --channel preview --platform android --environment preview",
    "submit:play": "eas submit --platform android --latest",
    "fastlane:build": "fastlane android build",
    "fastlane:internal": "fastlane android internal",
    "fastlane:beta": "fastlane android beta",
    "fastlane:release": "fastlane android release",
    "fastlane:deploy": "fastlane android deploy",
    "build:ios:sim": "eas build --profile development --platform ios --local",
    "build:ios:device": "eas build --profile development:device --platform ios --local",
    "build:ios:preview": "eas build --profile preview --platform ios --local",
    "build:ios:prod": "eas build --profile production --platform ios --local",
    "build:android:sim": "eas build --profile development --platform android --local",
    "build:android:device": "eas build --profile development:device --platform android --local",
    "build:android:preview": "eas build --profile preview --platform android --local",
    "build:android:prod": "eas build --profile production --platform android --local"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "@tanstack/react-query": "^5.104.3",
    "apisauce": "3.1.1",
    "axios": "^1.20.0",
    "date-fns": "^4.1.0",
    "expo": "~55.0.31",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.9",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.4",
    "expo-splash-screen": "~55.0.10",
    "expo-sqlite": "~55.0.20",
    "expo-system-ui": "~55.0.9",
    "i18next": "^23.14.0",
    "immer": "^11.1.21",
    "intl-pluralrules": "^2.0.1",
    "lottie-react-native": "7.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.0.1",
    "react-native": "0.83.10",
    "react-native-drawer-layout": "^4.0.1",
    "react-native-edge-to-edge": "~1.6.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "3.3.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-vision-camera": "4.7.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "react-native-worklets-core": "1.6.3",
    "setimmediate": "^1.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.2.1",
    "babel-preset-expo": "~55.0.25",
    "dependency-cruiser": "^17.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-reactotron": "^0.1.2",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.0",
    "reactotron-core-client": "^2.9.4",
    "reactotron-react-js": "^3.3.11",
    "reactotron-react-native": "^5.0.5",
    "reactotron-react-native-mmkv": "^0.2.6",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
