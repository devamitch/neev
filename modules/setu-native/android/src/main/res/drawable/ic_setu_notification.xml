<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar mark: Setu's broadcast glyph, a centre with two arcs opening from it.

  Every notification was using android.R.drawable.stat_notify_sync, the platform's generic sync
  arrows, so a received file and a message both appeared under a system icon that belongs to no app
  in particular. A small icon is drawn as a silhouette - Android keeps only the alpha and tints the
  rest - so this is white on transparent with no detail that survives at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,14.2m-2.3,0a2.3,2.3 0,1 1,4.6 0a2.3,2.3 0,1 1,-4.6 0" />

    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M8.3,10.5a5.2,5.2 0,0 1,7.4 0" />

    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M5.2,7.3a9.6,9.6 0,0 1,13.6 0" />
</vector>
