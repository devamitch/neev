<?xml version="1.0" encoding="utf-8"?>
<!--
    What Setu is willing to hand to another app.

    Received files live in app-private internal storage, which no other app can read. Giving a
    viewer a raw file:// URI into it throws FileUriExposedException on API 24+, which is why
    "open" on a received document reported that no app on the phone could handle it. A FileProvider
    grant is the only legal way to pass these out, and this one is deliberately narrow: the two
    directories Setu actually produces, and nothing else.
-->
<paths>
    <!-- Completed transfers, written by TransferIncomingHandler into filesDir/library. -->
    <files-path name="setu_library" path="library/" />
    <!-- Anything staged for an outbound share. -->
    <cache-path name="setu_share" path="share/" />
</paths>
